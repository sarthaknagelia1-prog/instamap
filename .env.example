# Database connection (defaults to SQLite for local development; switch to PostgreSQL in production)
DATABASE_URL=sqlite:///./growth_engine.db

# LLM Providers (Groq recommended for high-speed local development, Anthropic supported)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# Instagram Graph API (Phase 1 & Phase 6)
IG_ACCESS_TOKEN=
IG_USER_ID=

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

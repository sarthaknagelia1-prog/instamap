# Database connection (defaults to SQLite for local development; switch to PostgreSQL in production)
DATABASE_URL=sqlite:///./growth_engine.db

# LLM Provider — Groq (free, fast) is the default. Anthropic is optional.
GROQ_API_KEY=
DEFAULT_LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b

# Optional: Anthropic Claude (higher quality, paid)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: Langfuse tracing (Phase 3+)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Server Configuration
PORT=8000
HOST=127.0.0.1
ENVIRONMENT=development
REQUIRE_AUTH=false
# Set true behind HTTPS. Non-development environments always set Secure automatically.
SESSION_COOKIE_SECURE=false
# Production browser users must be provisioned with non-demo API_KEYS entries.
# API_KEYS={"<long-random-key>": {"user_id":"owner","workspace_id":"default","role":"admin"}}
